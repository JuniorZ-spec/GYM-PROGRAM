PORT=3001
BASE_URL=http://localhost:3001

# Connection string Postgres (Neon)
DATABASE_URL=

# Clé API OpenRouter (génération des plans d'entraînement)
OPEN_ROUTER_API_KEY=

# Origines autorisées en CORS, séparées par des virgules (ex: https://mon-app.vercel.app)
# Laisser vide en local pour tout autoriser.
CORS_ORIGIN=
